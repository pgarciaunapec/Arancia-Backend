{
  "name": "restaurant01-backend",
  "version": "1.0.0",
  "description": "Backend API for Restaurant01 - Node.js + Express + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed-all.ts",
    "seed:all": "tsx src/seeds/seed-all.ts",
    "seed:users": "tsx src/seeds/seed-users.ts",
    "seed:images": "tsx src/seeds/seed-images.ts",
    "seed:menu-items": "tsx src/seeds/seed-menu-items.ts",
    "seed:tables": "tsx src/seeds/seed-tables.ts",
    "seed:inventory-items": "tsx src/seeds/seed-inventory-items.ts",
    "seed:contacts": "tsx src/seeds/seed-contacts.ts",
    "seed:event-requests": "tsx src/seeds/seed-event-requests.ts",
    "seed:reservations": "tsx src/seeds/seed-reservations.ts",
    "seed:orders": "tsx src/seeds/seed-orders.ts",
    "seed:payments": "tsx src/seeds/seed-payments.ts",
    "seed:transactions": "tsx src/seeds/seed-transactions.ts",
    "seed:delivery-orders": "tsx src/seeds/seed-delivery-orders.ts",
    "seed:table-bills": "tsx src/seeds/seed-table-bills.ts",
    "seed:cash-registers": "tsx src/seeds/seed-cash-registers.ts",
    "sync-images": "node scripts/sync-images.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "minimist": "^1.2.8",
    "mongoose": "^8.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.2"
  }
}
