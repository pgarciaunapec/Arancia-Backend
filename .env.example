# ========================================
# ARANCIA BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and adjust values for your environment
# Syntax: VARIABLE_NAME=value OR VARIABLE_NAME=${default_value}
# ========================================

# ========================================
# Server Configuration
# ========================================
PORT=3003
NODE_ENV=production

# ========================================
# MongoDB Connection
# ========================================
# Local development
MONGODB_URI=mongodb://mongo:Pantonio2404@mongodb:27017/arancia
# Or for Dokploy (uncomment and adjust)
# MONGODB_URI=mongodb://mongo:Pantonio2404@mongodb-dbmongo-v6xllb:27017

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=arancia_prod_Xy7n8R!kQwq2Z7v
JWT_EXPIRES_IN=7d

# ========================================
# Frontend URL
# ========================================
# Local development
FRONTEND_URL=http://localhost:5173
# Production
# FRONTEND_URL=https://arancia-dev.nauvolan.abrdns.com

# ========================================
# Domain Configuration
# ========================================
# Local development
DOMAIN=localhost
# Production
# DOMAIN=arancia-api-dev.nauvolan.abrdns.com

# ========================================
# Traefik Configuration (For Dokploy deployment)
# Must be globally unique in your Traefik instance
# ========================================
TRAEFIK_ROUTER_NAME=arancia-backend-dev
TRAEFIK_SERVICE_NAME=arancia-backend-dev

# ========================================
# MongoDB Admin Credentials (for docker-compose)
# ========================================
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=Pantonio2404
MONGO_INITDB_DATABASE=arancia

# ========================================
# Docker Configuration
# ========================================
# Container names
MONGODB_CONTAINER_NAME=arancia-mongodb
BACKEND_CONTAINER_NAME=arancia-backend
NETWORK_NAME=arancia-network

# Ports mapping (host:container)
MONGODB_PORT=27017
BACKEND_PORT=3003
