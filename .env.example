# ========================================
# ARANCIA BACKEND - ENVIRONMENT VARIABLES
# ========================================

# Server Configuration
PORT=3003
NODE_ENV=production

# MongoDB Connection
MONGODB_URI=mongodb://user:password@mongodb-host:27017/arancia?authSource=admin&tls=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://arancia-dev.nauvolan.abrdns.com

# ========================================
# TRAEFIK & DOKPLOY CONFIGURATION
# ========================================

# Domain Configuration
DOMAIN=arancia-api-dev.nauvolan.abrdns.com

# Traefik Router & Service Names (must be unique per deployment)
TRAEFIK_ROUTER_NAME=arancia-backend-dev
TRAEFIK_SERVICE_NAME=arancia-backend-dev
